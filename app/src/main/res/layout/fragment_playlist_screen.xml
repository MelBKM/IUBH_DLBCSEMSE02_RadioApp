<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/playlist_spacerTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.03"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/playlist_labelPlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/playlist.currentPlaylist.label"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlist_spacerTop" />

    <TextView
        android:id="@+id/playlist_textViewCurrentPlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/playlist.currentPlaylist.defaultValue"
        android:textSize="34sp"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlist_labelPlaylist"
        app:layout_constraintWidth_percent="1" />

    <View
        android:id="@+id/playlist_spacer1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.02"
        app:layout_constraintTop_toBottomOf="@+id/playlist_textViewCurrentPlaylist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RatingBar
        android:id="@+id/playlist_ratingBarPlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:max="5"
        android:numStars="5"
        app:layout_constraintTop_toBottomOf="@+id/playlist_spacer1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/playlist_spacer2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.02"
        app:layout_constraintTop_toBottomOf="@+id/playlist_ratingBarPlaylist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/playlist_labelTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/playlist.currentSongTitle.label"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@+id/playlist_ratingBarPlaylist"
        app:layout_constraintTop_toBottomOf="@+id/playlist_spacer2" />

    <TextView
        android:id="@+id/playlist_textViewCurrentSongTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/playlist.currentSongTitle.defaultValue"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/playlist_labelReleaseDate"
        app:layout_constraintTop_toTopOf="@+id/playlist_labelTitle"
        app:layout_constraintWidth_percent="0.48" />

    <View
        android:id="@+id/playlist_spacer3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:textSize="18sp"
        app:layout_constraintHeight_percent="0.01"
        app:layout_constraintTop_toBottomOf="@+id/playlist_textViewCurrentSongTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/playlist_labelInterpreter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="@string/playlist.currentSongInterpreter.label"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/playlist_labelTitle"
        app:layout_constraintTop_toBottomOf="@+id/playlist_spacer3" />

    <TextView
        android:id="@+id/playlist_textViewCurrentSongInterpreter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="@string/playlist.currentSongInterpreter.defaultValue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/playlist_textViewCurrentSongTitle"
        app:layout_constraintTop_toTopOf="@+id/playlist_labelInterpreter"
        app:layout_constraintWidth_percent="0.5" />

    <View
        android:id="@+id/playlist_spacer4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:textSize="18sp"
        app:layout_constraintHeight_percent="0.01"
        app:layout_constraintTop_toBottomOf="@+id/playlist_textViewCurrentSongInterpreter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/playlist_labelAlbum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="@string/playlist.currentSongAlbum.label"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/playlist_labelInterpreter"
        app:layout_constraintTop_toBottomOf="@+id/playlist_spacer4" />

    <TextView
        android:id="@+id/playlist_textViewCurrentSongAlbum"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/playlist.currentSongAlbum.defaultValue"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/playlist_textViewCurrentSongTitle"
        app:layout_constraintTop_toTopOf="@+id/playlist_labelAlbum"
        app:layout_constraintWidth_percent="0.5" />

    <View
        android:id="@+id/playlist_spacer5"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.01"
        app:layout_constraintTop_toBottomOf="@+id/playlist_textViewCurrentSongAlbum"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/playlist_labelReleaseDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="@string/playlist.currentSongReleaseDate.label"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/playlist_labelAlbum"
        app:layout_constraintTop_toBottomOf="@+id/playlist_spacer5" />

    <TextView
        android:id="@+id/playlist_textViewCurrentSongReleaseDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/playlist.currentSongReleaseDate.defaultValue"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/playlist_textViewCurrentSongTitle"
        app:layout_constraintTop_toTopOf="@+id/playlist_labelReleaseDate"
        app:layout_constraintWidth_percent="0.4" />

    <View
        android:id="@+id/playlist_spacer6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.03"
        app:layout_constraintTop_toBottomOf="@+id/playlist_textViewCurrentSongReleaseDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/playlist_imageViewCurrentSongAlbumCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintTop_toBottomOf="@+id/playlist_spacer6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:srcCompat="@tools:sample/backgrounds/scenic" />

</androidx.constraintlayout.widget.ConstraintLayout>
